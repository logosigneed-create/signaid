    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "eslint": "^9.13.0",
    "eslint-config-next": "14.2.35",
