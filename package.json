    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.5.1",
    "esbuild": "0.21.5",
    "firebase": "^12.12.1",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "idb-keyval": "^6.2.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.14.0",
    "next": "14.2.35",
    "onnxruntime-web": "^1.31.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.5.6",
    "react-image-crop": "^11.0.10",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@rollup/wasm-node": "^4.57.1",
