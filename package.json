{
  "name": "signaid-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js --host --port 3847 --strictPort",
    "api": "node scripts/api-server.cjs",
    "dev:next": "next dev",
    "build": "tsc -b && vite build && node -e \"require('fs').copyFileSync('dist/index.html', 'functions/index.html'); console.log('✅ [Build Hook] functions/index.html synchronisé');\"",
    "build:next": "next build",
    "start:next": "next start",
    "lint": "eslint .",
    "preview": "vite preview --port 3847 --strictPort",
    "preview:deploy": "firebase hosting:channel:deploy staging",
    "deploy:hosting": "npm run build && firebase deploy --only hosting,functions:renderSEO",
    "ship": "npm run build && firebase deploy --only hosting,functions:renderSEO,functions:getUserBySlug",
    "deploy": "npm run build && firebase deploy --only hosting,functions:renderSEO,functions:getUserBySlug"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@google/genai": "^1.30.0",
