import { STYLE_MATRIX } from '../constants';

// Dynamic import helper
// Dynamic import helper
const getClient = async () => {
    // Shared API Key for all users
    const SHARED_API_KEY = "AIzaSyBvd07dBlJNv3MbxXxzcqwAvZkNfxiQRug";

    // Dynamic import to avoid loading the SDK in the main bundle
    const lib = await import("@google/genai");
    const ai = new lib.GoogleGenAI({ apiKey: SHARED_API_KEY });
    return { ai, lib };
};

export const generateTryOnImage = async (
    userPhotoBase64: string,
    garmentPreviewBase64: string,
    garmentDescription: string,
    prompt: string,
    styleCategory: string,
    pose: 'front' | 'back',
    uploadedGarmentBase64: string | null = null,
    explicitGlassesPrompt: string | null = null // Nouvelle prop explicite pour les lunettes
): Promise<string> => {
    const { ai, lib } = await getClient();
    const { HarmCategory, HarmBlockThreshold } = lib;

    // Clean base64 strings
    const cleanUserPhoto = userPhotoBase64.split(',')[1] || userPhotoBase64;
    const cleanGarmentPreview = garmentPreviewBase64.split(',')[1] || garmentPreviewBase64;

    // --- GLASSES LOGIC ---
    let glassesPrompt = "";

    if (explicitGlassesPrompt) {
        glassesPrompt = explicitGlassesPrompt;
    } else {
        // Fallback logic (Old method)
        // 1. Try to find if the category/style name matches a specific style definition
        let foundStyle = null;

        // Check if it matches a specific style name directly (e.g., "Cyberpunk", "Lego")
        for (const cat in STYLE_MATRIX) {
            const match = STYLE_MATRIX[cat].find(s => s.name.toLowerCase() === styleCategory.toLowerCase() || s.name.toLowerCase().includes(styleCategory.toLowerCase()));
            if (match) {
                foundStyle = match;
                break;
            }
        }

        if (foundStyle && foundStyle.glasses) {
            glassesPrompt = foundStyle.glasses;
        } else if (styleCategory === 'Réaliste' || styleCategory === 'Paparazzi') {
            // Fallback if just generic "Réaliste" or "Paparazzi" category is selected
            glassesPrompt = "wearing stylish sunglasses";
        }
    }

    // Explicit exclusions just in case (though STYLE_MATRIX should handle it via null glasses)
    const lowerCat = styleCategory.toLowerCase();
    if (lowerCat.includes('pixar') || lowerCat.includes('lego') || lowerCat.includes('disney') || lowerCat.includes('pop') || lowerCat.includes('comic') || lowerCat.includes('cartoon') || lowerCat.includes('illustration') || lowerCat.includes('3d') || lowerCat.includes('clay') || lowerCat.includes('pâte à modeler')) {
        // If explicitly forced null/empty in calling code or known deformation style, ensure it's empty
        if (!explicitGlassesPrompt) glassesPrompt = "";
    }


    // Construct the prompt
    // We explicitly instruct the model to ONLY return an image.
    let fullPrompt = `
    You are an expert fashion AI.
    Task: Generate a photorealistic image based on the provided inputs.
    
    Input 1: User's photo (Person).
    Input 2: Garment design preview (Overlay on mannequin).
    ${uploadedGarmentBase64 ? 'Input 3: Garment Reference (Texture/Shape).' : ''}
    
    INSTRUCTIONS:
    1.  **ACTION**: Apply the garment design from Input 2 onto the person in Input 1.
    2.  **FORMAT**: Vertical Portrait (9:16).
    3.  **FRAMING**: Medium Shot (Waist-up). Center the subject.
    4.  **INTEGRITY**: Preserve the user's facial features, hair, and body shape EXACTLY. HEAD MUST BE FULLY VISIBLE.
    5.  **DETAILS**: Preserve the garment's color, logo, text, and placement EXACTLY.
    6.  **POSE**: ${pose === 'front' ? 'FULL FRONT VIEW. Subject is facing the camera. Face, chest and front of body visible.' : 'BACK VIEW. Subject is facing away from camera. Back of head and back of body visible.'}.
    7.  **STYLE**: ${prompt}. ${glassesPrompt ? `IMPORTANT DETIAL: The person is ${glassesPrompt}.` : ''}
    8.  **OUTPUT REQUIREMENT**: Return ONLY the generated image. Do NOT provide any text description or introduction.
    `;

    const parts: any[] = [
        {
            inlineData: {
                mimeType: 'image/jpeg',
                data: cleanUserPhoto
            }
        },
        {
            inlineData: {
                mimeType: 'image/png',
                data: cleanGarmentPreview
            }
        },
        {
            text: fullPrompt
        }
    ];

    if (uploadedGarmentBase64) {
        const cleanUploaded = uploadedGarmentBase64.split(',')[1] || uploadedGarmentBase64;
        parts.splice(2, 0, {
            inlineData: {
                mimeType: 'image/jpeg',
                data: cleanUploaded
            }
        });
    }

    try {
        // Upgrade to gemini-3-pro-image-preview for better quality and adherence to strict image-only prompts
        // Retry logic for 503 errors (Model Overloaded)
        let response: any = null;
        let retries = 3;
        let delay = 2000; // Start with 2 seconds

        while (retries > 0) {
            try {
                response = await ai.models.generateContent({
                    model: 'gemini-1.5-flash', // Switching to stable vision model
                    contents: {
                        parts: parts
                    },
                    config: {
                        // Optimize for speed and size

                        candidateCount: 1,
                        safetySettings: [
                            { category: HarmCategory.HARM_CATEGORY_HATE_SPEECH, threshold: HarmBlockThreshold.BLOCK_NONE },
                            { category: HarmCategory.HARM_CATEGORY_SEXUALLY_EXPLICIT, threshold: HarmBlockThreshold.BLOCK_NONE },
                            { category: HarmCategory.HARM_CATEGORY_DANGEROUS_CONTENT, threshold: HarmBlockThreshold.BLOCK_NONE },
                            { category: HarmCategory.HARM_CATEGORY_HARASSMENT, threshold: HarmBlockThreshold.BLOCK_NONE },
                            { category: HarmCategory.HARM_CATEGORY_CIVIC_INTEGRITY, threshold: HarmBlockThreshold.BLOCK_NONE }
                        ]
                    }
                });
                break; // Success, exit loop
            } catch (error: any) {
                if (error.message && error.message.includes('503') && retries > 1) {
                    console.warn(`Model overloaded (503). Retrying in ${delay / 1000}s... (${retries - 1} retries left)`);
                    await new Promise(resolve => setTimeout(resolve, delay));
                    delay *= 2; // Exponential backoff
                    retries--;
                } else {
                    throw error; // Re-throw other errors or if retries exhausted
                }
            }
        }

        if (!response || !response.candidates || response.candidates.length === 0) {
            throw new Error("No candidates returned from Gemini API.");
        }

        let textResponse = '';
        const candidate = response.candidates[0];

        // Search for image in parts
        if (candidate && candidate.content && candidate.content.parts) {
            for (const part of candidate.content.parts) {
                if (part.inlineData && part.inlineData.data) {
                    return `data:${part.inlineData.mimeType || 'image/png'};base64,${part.inlineData.data}`;
                }
                if (part.text) {
                    textResponse += part.text;
                }
            }
        }

        // Check for safety filters or other finish reasons
        if (candidate.finishReason && candidate.finishReason !== 'STOP') {
            textResponse += ` (Finish Reason: ${candidate.finishReason})`;
        }

        // If we get here, no image was found
        let errorMessage = "No image generated by the model.";
        if (textResponse) {
            errorMessage += ` Model response: ${textResponse}`;
        }

        throw new Error(errorMessage);

    } catch (error) {
        console.error("Gemini API Error:", error);
        throw error;
    }
};

export const geminiService = {
    generateTryOnImage
};