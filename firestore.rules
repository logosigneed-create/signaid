rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Function
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'logosigneed@gmail.com' || 
        request.auth.token.email == 'nicolas@signaid.be' ||
        request.auth.token.admin == true
      );
    }

    // Global Settings (Pricing, Dimensions, Flyer, Banner, etc.)
    match /settings/{settingId} {
      allow read: if true; 
      allow write: if isAdmin();
    }

    // Contact Messages
    match /contact_messages/{document} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }

    // AI Generation Logs (Guests & Users)
    match /generation_logs/{document} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
    }

    // Feedback
    match /feedback/{document} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
    }

    // Posts & Gallery
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.user.id;
    }

    // Users
    match /users/{userId} {
      // Allow user to read/write their own data OR Admin to read all
      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow create: if request.auth != null;
      // Allow user to read own orders OR Admin to read all
      allow read: if (request.auth != null && (resource.data.email == request.auth.token.email || resource.data.userId == request.auth.uid)) || isAdmin();
    }

    // Quotes
    match /quotes/{quoteId} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
    }

    // Redemptions
    match /redemptions/{redemptionId} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
    }

    // Products (Catalog)
    match /products/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Chat Sessions
    match /chats/{sessionId}/messages/{messageId} {
      allow create, read: if request.auth != null && (request.auth.uid == sessionId || isAdmin()); 
      allow update, delete: if isAdmin();
    }

    // Chat Notifications
    match /chat_notifications/{notifId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Design Sharing
    match /sharedDesigns/{designId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    match /shortLinks/{shortId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // BTP / Portail Projects & Dotations
    match /btp_projects/{projectId} {
      allow read, create, update, delete: if true;
    }

    match /btp_dotations/{dotationId} {
      allow read, create, update, delete: if true;
    }

    match /anonymous_previews/{previewId} {
      allow read, create, update, delete: if true;
    }

    // Vitrine / Site Configuration
    match /configs/{configId} {
      allow read, create, update, delete: if true;
    }

    match /SiteConfigs/{configId} {
      allow read, create, update, delete: if true;
    }

    // Portail General Configuration (Placements, etc.)
    match /portail-config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Inbound Leads
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Access Requests (Infrastructure Claim Modal)
    match /access_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Default: Strictly deny all unhandled access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

