rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Function
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'logosigneed@gmail.com' || 
        request.auth.token.email == 'nicolas@signaid.be' ||
        request.auth.token.admin == true
      );
    }

    // Catalogue produits et configurations publiques
    match /products/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /SiteConfigs/{document=**} {
      allow read, write: if true;
    }
    match /portail-config/{document=**} {
      allow read, write: if true;
    }
    
    // Audits, previews et sessions
    match /audits/{document=**} {
      allow read, write: if true;
    }
    match /sessions/{document=**} {
      allow read, write: if true;
    }
    match /anonymous_previews/{document=**} {
      allow read, write: if true;
    }
    match /btp_projects/{document=**} {
      allow read, write: if true;
    }
    match /showcases/{document=**} {
      allow read, write: if true;
    }
    match /generation_logs/{document=**} {
      allow read, write: if true;
    }
    
    // Utilisateurs connectés ou anonymes
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Global Settings (Pricing, Dimensions, Flyer, Banner, etc.)
    match /settings/{settingId} {
      allow read: if true; 
      allow write: if isAdmin();
    }

    // Contact Messages
    match /contact_messages/{document=**} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Feedback
    match /feedback/{document=**} {
      allow create: if true;
      allow read: if isAdmin();
    }

    // Posts & Gallery
    match /posts/{document=**} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.user.id || isAdmin());
    }

    // Orders
    match /orders/{document=**} {
      allow create: if true;
      allow read: if (request.auth != null && (resource.data.email == request.auth.token.email || resource.data.userId == request.auth.uid)) || isAdmin();
    }

    // Quotes
    match /quotes/{document=**} {
      allow create: if true;
      allow read: if isAdmin();
    }

    // Redemptions
    match /redemptions/{document=**} {
      allow create: if true;
      allow read: if isAdmin();
    }

    // Chat Sessions
    match /chats/{sessionId}/messages/{messageId} {
      allow create, read: if true; 
      allow update, delete: if isAdmin();
    }

    // Chat Notifications
    match /chat_notifications/{notifId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Design Sharing
    match /sharedDesigns/{document=**} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    match /shortLinks/{document=**} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // BTP / Portail Projects & Dotations (recursive)
    match /audit_projects/{document=**} {
      allow read, create, update, delete: if true;
    }

    match /projects/{document=**} {
      allow read, create, update, delete: if true;
    }

    match /btp_dotations/{document=**} {
      allow read, create, update, delete: if true;
    }

    // Vitrine / Site Configuration (recursive: covers SiteConfigs/{slug}/mockups/{id})
    match /configs/{document=**} {
      allow read, create, update, delete: if true;
    }

    match /audit_catalog/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    match /custom_audit_products/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    match /audit_custom_products/{document=**} {
      allow read, create, update, delete: if true;
    }

    match /audit_products/{document=**} {
      allow read, create, update, delete: if true;
    }

    match /prospects/{document=**} {
      allow read, create, update, delete: if true;
    }

    // Inbound Leads
    match /leads/{document=**} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Prospect Requests (Landing Page Application Form)
    match /prospect_requests/{document=**} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Access Requests (Infrastructure Claim Modal)
    match /access_requests/{document=**} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // DJ Sales (Dashboard stats & margins)
    match /dj_sales/{document=**} {
      allow read, create, update, delete: if true;
    }

    // Default: Strictly deny all unhandled access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
