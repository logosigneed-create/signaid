{
    "hosting": {
        "public": "dist",
        "cleanUrls": true,
        "trailingSlash": false,
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**",
            "imported_products/**",
            "admin-stylist/**",
            "assets/prospects/**",
            "**/*.zip",
            "**/*.php",
            "**/*.bak"
        ],
        "rewrites": [
            {
                "source": "/assets/**",
                "destination": "/assets/**"
            },
            {
                "source": "/api/user-by-slug**",
                "function": "getUserBySlug"
            },
            {
                "source": "/getUserBySlug**",
                "function": "getUserBySlug"
            },
            {
                "source": "**",
                "destination": "/index.html"
            }
        ],
        "headers": [
            {
                "source": "/**",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "/assets/**",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=31536000, immutable"
                    }
                ]
            }
        ]
    },
    "functions": {
        "source": "functions",
        "predeploy": [
            "node scripts/syncFunctionsHtml.cjs"
        ]
    },
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "storage": {
        "rules": "storage.rules"
    }
}
